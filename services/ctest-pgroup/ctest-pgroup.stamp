input  main.c sha256 c17a204952bdfc7e1682b3d90a4df783bdae6e2a8df0d0d2009039e68656f379
input  toolchain/sysroot/lib/libc.a sha256 18987fd133823c948ae9550c531fcdf3bf46c1fe56a9fc445f0bab4135f18841
output ctest-pgroup.elf sha256 704413e031701d6e9d9d40e78a0f91d978035c1c2efdf17cac96624c159b9741 size 2611504
