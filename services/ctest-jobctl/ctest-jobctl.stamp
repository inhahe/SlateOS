input  main.c sha256 e27d1821c98f937ac33f1653a09ac0a56f536427ce6336bbb568a70f86b91371
input  toolchain/sysroot/lib/libc.a sha256 73efe5b393c3dea1df28f392364cb68c88d14185a14d1734997a460bd8c9a5e1
output ctest-jobctl.elf sha256 1c39aa9d222cec3791a0ff3bc24eaf3ff19dbedf39d8b6076a7a146476d9574f size 2645416
