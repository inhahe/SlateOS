# The Linux configuration every driver process is compiled against, applied on
# top of `allnoconfig` (design-decisions 1578). scripts/linux-tree.sh checks
# that every line here is what the resulting .config says: Kconfig drops an
# option whose dependencies are unmet without a word.

CONFIG_64BIT=y

# The execution model (1578 rule 5): one CPU, no preemption.
# CONFIG_SMP is not set
CONFIG_PREEMPT_NONE=y

# Nothing that needs the kernel's own runtime: no stack protector (its canary
# is per-CPU data reached through %gs), no mitigation thunks
# (`__x86_return_thunk` and the retpolines are kernel symbols), no modules
# (drivers are built in, and the layer runs their initcalls).
# CONFIG_STACKPROTECTOR is not set
# CONFIG_CPU_MITIGATIONS is not set
# CONFIG_MODULES is not set

# What the drivers below stand on.
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y

# The drivers.
CONFIG_E1000E=y
