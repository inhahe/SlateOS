diff -ru a/libavcodec/h264_mb.c b/libavcodec/h264_mb.c
--- a/libavcodec/h264_mb.c	2026-10-10 14:22:25.245057229 -0400
+++ b/libavcodec/h264_mb.c	2026-10-10 14:22:25.252390563 -0400
@@ -1,3 +1,5 @@
+#include <stdio.h>
+#include <stdlib.h>
 /*
  * H.26L/H.264/AVC/JVT/14496-10/... decoder
  * Copyright (c) 2003 Michael Niedermayer <michaelni@gmx.at>
@@ -815,4 +817,60 @@
         hl_decode_mb_simple_16(h, sl);
     } else
         hl_decode_mb_simple_8(h, sl);
+    {
+        static int dbg = -1;
+        if (dbg < 0)
+            dbg = getenv("FFDBG_MB") != NULL;
+        if (dbg) {
+            const int mb_x = sl->mb_x, mb_y = sl->mb_y;
+            const int ps = h->pixel_shift;
+            const int c444 = CHROMA444(h);
+            const int block_h = 16 >> h->chroma_y_shift;
+            ptrdiff_t ls = sl->linesize, uvls = sl->uvlinesize;
+            uint8_t *d[3];
+            int rows[3], cols[3], pl, y, x;
+            uint32_t sum[3];
+            if (c444) {
+                for (pl = 0; pl < 3; pl++) {
+                    d[pl] = h->cur_pic.f->data[pl] + ((mb_x << ps) + mb_y * ls) * 16;
+                    rows[pl] = 16;
+                    cols[pl] = 16;
+                }
+            } else {
+                d[0] = h->cur_pic.f->data[0] + ((mb_x << ps) + mb_y * ls) * 16;
+                d[1] = h->cur_pic.f->data[1] + (mb_x << ps) * 8 + mb_y * uvls * block_h;
+                d[2] = h->cur_pic.f->data[2] + (mb_x << ps) * 8 + mb_y * uvls * block_h;
+                rows[0] = 16; cols[0] = 16;
+                rows[1] = rows[2] = block_h;
+                cols[1] = cols[2] = 8;
+            }
+            if (MB_FIELD(sl)) {
+                if (mb_y & 1) {
+                    d[0] -= ls * 15;
+                    if (c444) {
+                        d[1] -= ls * 15;
+                        d[2] -= ls * 15;
+                    } else {
+                        d[1] -= uvls * (block_h - 1);
+                        d[2] -= uvls * (block_h - 1);
+                    }
+                }
+                ls *= 2;
+                uvls *= 2;
+            }
+            for (pl = 0; pl < 3; pl++) {
+                uint32_t a = 1, b = 0;
+                ptrdiff_t stride = (pl && !c444) ? uvls : ls;
+                for (y = 0; y < rows[pl]; y++)
+                    for (x = 0; x < (cols[pl] << ps); x++) {
+                        a = (a + d[pl][y * stride + x]) % 65521;
+                        b = (b + a) % 65521;
+                    }
+                sum[pl] = (b << 16) | a;
+            }
+            fprintf(stderr, "MB poc=%d mb=%d,%d type=%x cbp=%x qp=%d sum=%08x,%08x,%08x h=%d\n",
+                    h->cur_pic_ptr->poc, mb_x, mb_y, mb_type, sl->cbp, sl->qscale,
+                    sum[0], sum[1], sum[2], h->ffdbg_id);
+        }
+    }
 }
