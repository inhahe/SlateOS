# SlateOS's own Calculator, as a desktop entry (gui/programs, design-decisions.md 1425).
# Built into the programs library; the same file installs as
# /usr/share/applications/org.slateos.Calculator.desktop. What each field carries,
# and where it came from, is gui/programs/INVENTORY.md.

[Desktop Entry]
Type=Application
Name=Calculator
GenericName=Calculator
Comment=Scientific calculator
Exec=/usr/bin/calculator
TryExec=/usr/bin/calculator
Icon=accessories-calculator
Categories=Utility;Calculator;
Keywords=calc;math;compute;
