text/x-c++=org.slateos.Editor.desktop
text/x-python=org.slateos.Editor.desktop
text/x-rust=org.slateos.Editor.desktop
application/gzip=org.slateos.ArchiveManager.desktop
application/json=org.slateos.Editor.desktop
application/pdf=org.slateos.PdfViewer.desktop
application/rtf=org.slateos.Editor.desktop
application/sql=org.slateos.Editor.desktop
