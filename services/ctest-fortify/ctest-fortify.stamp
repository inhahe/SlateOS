input  main.c sha256 fcdc165fc7abb0c5fe224320668ef43b15485c3aa8e14eacc3d0e1eaf0cb4a3c
input  toolchain/sysroot/lib/libc.a sha256 73efe5b393c3dea1df28f392364cb68c88d14185a14d1734997a460bd8c9a5e1
output ctest-fortify.elf sha256 75d3e97e5a7fd0c8555e53d4bab919d9509639f301901ec288ca6c030cb73f22 size 2639424
