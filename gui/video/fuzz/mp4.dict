# Counts and sizes at the edges: none, one, the signed and unsigned
# extremes, and FFmpeg's ceilings (89478485 and 178956970 entries).
"\x00\x00\x00\x00"
"\x00\x00\x00\x01"
"\x7f\xff\xff\xff"
"\x80\x00\x00\x00"
"\xff\xff\xff\xff"
"\x05\x55\x55\x55"
"\x0a\xaa\xaa\xaa"
