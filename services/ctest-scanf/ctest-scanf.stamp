input  main.c sha256 525cb278bd8916c6c7a02a0e37b151d8da7a96e0d446982ca976c29905e2691c
input  toolchain/sysroot/lib/libc.a sha256 5452152d19a00555a4ba99de5f3f6168fa5df3c8214aa89d87b9fa9fa5a68dbd
output ctest-scanf.elf sha256 eb1ae5632d5828bb99daaead702286a03d41c558e1acfce2aec8bb2ebca802a2 size 1420008
