input  main.c sha256 525cb278bd8916c6c7a02a0e37b151d8da7a96e0d446982ca976c29905e2691c
input  toolchain/sysroot/lib/libc.a sha256 a2dbcc11a19b4cd7b9301fdf988d4f86db642726ccf5c38b5a669006686f5e4a
output ctest-scanf.elf sha256 02fddd2658d441c67ec44ee459474986640c10e9da451bf3d4a92e3ed4ccd11b size 2632312
