input  main.c sha256 c17a204952bdfc7e1682b3d90a4df783bdae6e2a8df0d0d2009039e68656f379
input  toolchain/sysroot/lib/libc.a sha256 73efe5b393c3dea1df28f392364cb68c88d14185a14d1734997a460bd8c9a5e1
output ctest-pgroup.elf sha256 ce248827c82a3549d319fe059775772ee7207116f394c866d8e13e2064660072 size 2635192
