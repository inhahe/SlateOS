# libFuzzer's dictionary for the `subtitles` target: the markup the subtitle
# readers take apart, so that mutations reach the parsers and not only the
# Matroska framing around them. One quoted token a line.

# SubRip and SRT markup
"<i>"
"</i>"
"<b>"
"</b>"
"<u>"
"</u>"
"<s>"
"</s>"
"<font color=\"#ff0000\">"
"<font face=\"Arial\">"
"<font size=\"20\">"
"</font>"
"<br>"
"<br/>"
"{\\an8}"
"\\N"
"\\n"
"\\h"

# ASS override tags
"{\\i1}"
"{\\i0}"
"{\\b700}"
"{\\u1}"
"{\\s1}"
"{\\c&H0000FF&}"
"{\\1c&HFF&}"
"{\\c}"
"{\\fnTimes}"
"{\\fn}"
"{\\fs40}"
"{\\fs+5}"
"{\\fs-5}"
"{\\fs}"
"{\\an5}"
"{\\a6}"
"{\\r}"
"{\\rDefault}"
"{\\p1}"
"{\\p0}"
"{\\q2}"
"{\\t(\\fs40)}"
"{\\pos(10,20)}"
"\\{"
"\\}"

# ASS script headers
"[Script Info]"
"[V4+ Styles]"
"[V4 Styles]"
"[Events]"
"PlayResY: 720"
"PlayResX: 1280"
"WrapStyle: 2"
"ScriptType: v4.00+"
"Format: Name, Fontname, Fontsize, PrimaryColour, Bold, Italic, Alignment"
"Style: Default,Arial,16,&H00FFFFFF,0,0,2"

# WebVTT cue text and settings
"<c.yellow>"
"</c>"
"<v Roger>"
"<lang en>"
"<ruby>"
"<rt>"
"</rt>"
"</ruby>"
"<00:00:01.000>"
"&amp;"
"&lt;"
"&nbsp;"
"&#39;"
"&#x41;"
"line:0"
"line:-1"
"line:50%,center"
"position:20%,line-left"
"size:50%"
"align:start"
"align:end"
"vertical:rl"

# Matroska codec IDs for subtitle tracks
"S_TEXT/UTF8"
"S_TEXT/ASS"
"S_TEXT/SSA"
"S_TEXT/WEBVTT"
"D_WEBVTT/SUBTITLES"
"S_HDMV/PGS"
"S_VOBSUB"
"S_DVBSUB"
"size: 720x480"
"palette: "

# PGS segment headers (type, then a 16-bit length): an end segment whole;
# a composition, palette, object and window header each of a short length;
# composition states (epoch start, acquisition point); an object's first
# and last segment flags; a long run of colour 1.
"\x80\x00\x00"
"\x16\x00\x13"
"\x14\x00\x07"
"\x15\x00\x0f"
"\x17\x00\x0a"
"\x80\x00\x00\x00"
"\x40\x00\x00\x00"
"\xc0\x00"
"\x00\xc1\x00\x01"

# VobSub control commands: a forced start, a start, a stop, colours,
# alphas, an area, field offsets, the end of a sequence; a run filling the
# rest of a line.
"\x00"
"\x01\xff"
"\x02\xff"
"\x03\x32\x10"
"\x04\xff\xf0"
"\x05\x00\x00\x2f\x00\x00\x1f"
"\x06\x00\x04\x00\x20"
"\x00\x03"

# DVB segment headers (the sync byte, a type, page 1, a 16-bit length): an
# end of display set whole; a page, region, CLUT, object and display
# definition header each of a short length; page states (acquisition point,
# mode change); a region of each depth; a CLUT entry for each table, full
# range; pixel data types (2-, 4-, 8-bit strings, map tables, end of line)
# and the strings' end codes.
"\x0f\x80\x00\x01\x00\x00"
"\x0f\x10\x00\x01\x00\x08"
"\x0f\x11\x00\x01\x00\x10"
"\x0f\x12\x00\x01\x00\x08"
"\x0f\x13\x00\x01\x00\x10"
"\x0f\x14\x00\x01\x00\x05"
"\x0a\x07"
"\x0a\x0b"
"\x27\x01\x00\x00"
"\x4b\x01\x00\x00"
"\x6f\x01\x00\x00"
"\x01\x81\xeb\x80\x80\x00"
"\x01\x41\xeb\x80\x80\x00"
"\x01\x21\xeb\x80\x80\x00"
"\x10"
"\x11"
"\x12"
"\x20\x07\x8f"
"\x21\x00\x77\x88\xff"
"\x22"
"\xf0"
"\x00\x00"
