# SlateOS's own Calendar, as a desktop entry (gui/programs, design-decisions.md 1425).
# Built into the programs library; the same file installs as
# /usr/share/applications/org.slateos.Calendar.desktop. What each field carries,
# and where it came from, is gui/programs/INVENTORY.md.

[Desktop Entry]
Type=Application
Name=Calendar
GenericName=Calendar
Comment=Calendar and event management
Exec=/usr/bin/calendar
TryExec=/usr/bin/calendar
Icon=x-office-calendar
Categories=Office;Calendar;
Keywords=events;reminders;schedule;
