# What every driver process is built from, whatever its driver: the layer's
# C half and the Linux code it stands on. `scripts/linux-tree.sh driver`
# reads this before the driver's own manifest, which adds the driver.
# `linux` lines: Linux's own objects, by path in the tree, built by Linux's
# make. `layer` lines: the layer's own C files, by path under linuxdrv/.

# printk's formatting, and the string and character functions it uses.
linux lib/vsprintf.o
linux lib/string.o
linux lib/ctype.o
linux lib/hexdump.o
linux lib/uuid.o

# Waiting and locking, Linux's own, over the layer's scheduler; lx_emul.c
# runs wait_bit_init() before the first initcall.
linux kernel/sched/wait.o
linux kernel/sched/completion.o
linux kernel/sched/swait.o
linux kernel/sched/wait_bit.o
linux kernel/locking/mutex.o

# Kernel threads, Linux's own: kthread_create(), kthread_stop(), parking,
# kthread workers and kthreadd, over the layer's kernel_thread() and
# do_exit() (lx_sched.c); kasprintf for their names.
linux kernel/kthread.o
linux lib/kasprintf.o
# Jiffies to and from milliseconds and the rest, for any value.
linux kernel/time/time.o

# Workqueues, Linux's own, with the ID allocators they number workers and
# pools by.
linux kernel/workqueue.o
linux lib/idr.o
linux lib/radix-tree.o
linux lib/xarray.o

# Reference counts' overflow warning, which the inline counters call
# (lx_sched.c counts its tasks' records).
linux lib/refcount.o

# Softirqs, tasklets and the timer wheel, run by the layer's loop as Linux's
# tick and ksoftirqd would (lx_softirq.c).
linux kernel/softirq.o
linux kernel/time/timer.o
# Bit searches and operations: the wheel finds its next timer by them,
# the workqueues keep their CPU masks with them. (Population counts are
# the layer's own, lx_emul.c.)
linux lib/find_bit.o
linux lib/bitmap.o
# High-resolution timers' queues (lx_hrtimer.c), ordered by Linux's own
# timer queue over its red-black trees.
linux lib/rbtree.o
linux lib/timerqueue.o

# The driver core, Linux's own: devices, drivers, buses and classes, their
# matching and probing, and managed resources (devres); lx_emul.c runs its
# setup before the first initcall, as Linux's driver_init(). Its file system
# view, sysfs, is the layer's (lx_fs.c): nothing in a driver process
# reads it.
linux drivers/base/core.o
linux drivers/base/bus.o
linux drivers/base/dd.o
linux drivers/base/driver.o
linux drivers/base/class.o
linux drivers/base/devres.o
linux drivers/base/faux.o
linux drivers/base/platform.o
linux lib/kobject.o
linux lib/klist.o
# Sleepable RCU, which the driver core's device links read under: Linux's
# tiny SRCU, its grace periods driven by a work item and an irq_work, which
# the layer's loop runs as Linux's tick does (lx_softirq.c).
linux kernel/rcu/srcutiny.o
linux kernel/irq_work.o
# What the driver core stands on: notifier chains, read-write semaphores,
# asynchronous probing, firmware-node properties and software nodes, and
# the string and number-parsing helpers it names objects with (the
# duplicating ones are lx_emul.c's).
linux kernel/notifier.o
linux kernel/locking/rwsem.o
linux kernel/async.o
linux drivers/base/property.o
linux drivers/base/swnode.o
linux lib/kstrtox.o
linux lib/cmdline.o
linux lib/string_helpers.o
# vsprintf's hashing of printed pointers (%p).
linux lib/siphash.o

# Module parameters, Linux's own: an argument <module>.<parameter>=<value>
# sets one as Linux's command line does, each level's just before its
# initcalls (lx_emul.c), and their kinds' parsing is Linux's.
linux kernel/params.o

# The firmware loader, Linux's own: request_firmware() and its kin look in
# firmware_class.path, then /lib/firmware, reading through the system's own
# files (lx_fs.c's kernel_read_file_from_path_initns); firmware built into
# the program first, of which there is none.
linux drivers/base/firmware_loader/main.o
linux drivers/base/firmware_loader/builtin/main.o

# The PCI core, Linux's own: buses scanned, functions read and set up,
# their BARs claimed in the resource tree, drivers matched by their id
# tables, quirks, and register mappings (pci_iomap, ioread/iowrite). The
# layer gives it the functions the process was given (lx_pci.c), and maps
# their BARs (ioremap).
linux drivers/pci/access.o
linux drivers/pci/bus.o
linux drivers/pci/probe.o
linux drivers/pci/host-bridge.o
linux drivers/pci/remove.o
linux drivers/pci/pci.o
linux drivers/pci/pci-driver.o
linux drivers/pci/search.o
linux drivers/pci/setup-res.o
linux drivers/pci/setup-bus.o
linux drivers/pci/iomap.o
linux drivers/pci/quirks.o
linux drivers/pci/pci-sysfs.o
linux drivers/pci/pci-label.o
linux drivers/pci/vpd.o
linux drivers/pci/pcie/aspm.o
linux drivers/pci/vc.o
linux drivers/pci/rebar.o
linux drivers/pci/slot.o
linux drivers/pci/proc.o
linux drivers/pci/irq.o
linux drivers/pci/msi/pcidev_msi.o
linux lib/ratelimit.o
linux kernel/resource.o
linux lib/iomap.o

