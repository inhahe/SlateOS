# SlateOS's own Music Player, as a desktop entry (gui/programs, design-decisions.md 1425).
# Built into the programs library; the same file installs as
# /usr/share/applications/org.slateos.MusicPlayer.desktop. What each field carries,
# and where it came from, is gui/programs/INVENTORY.md.

[Desktop Entry]
Type=Application
Name=Music Player
GenericName=Audio Player
Comment=Play music and audio files
Exec=/usr/bin/musicplayer %F
TryExec=/usr/bin/musicplayer
Icon=audio-x-generic
Categories=AudioVideo;Audio;Player;
Keywords=music;vlc;mpv;audio;song;mp3;media;
MimeType=audio/mpeg;audio/wav;audio/ogg;audio/flac;audio/mp4;audio/aac;audio/opus;
