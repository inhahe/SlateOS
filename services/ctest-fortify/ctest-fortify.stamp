input  main.c sha256 fcdc165fc7abb0c5fe224320668ef43b15485c3aa8e14eacc3d0e1eaf0cb4a3c
input  toolchain/sysroot/lib/libc.a sha256 5915b6ca18a2ef670f539b2d142721271287977067ccded75c43679f4af4b2a7
output ctest-fortify.elf sha256 1d54ee3149a1218d860ce59c2afeaf660572b3bcea929a4d8df6bc6048bbfc56 size 2639384
