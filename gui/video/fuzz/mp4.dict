"stsd"
"stts"
"ctts"
"stsc"
"stsz"
"stz2"
"stco"
"co64"
"stss"
"stps"
"sdtp"
"sbgp"
"rap "
"udta"
"tref"
"sinf"
"schi"
"mdat"
"free"
"hoov"
"cmov"

# Fragments.
"mvex"
"trex"
"moof"
"traf"
"tfhd"
"tfdt"
"trun"

# What a sample entry carries.
"avcC"
"hvcC"
"av1C"
"vpcC"
"glbl"
"esds"
"dOps"
"dfLa"
"colr"
