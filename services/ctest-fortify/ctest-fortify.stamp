input  main.c sha256 fcdc165fc7abb0c5fe224320668ef43b15485c3aa8e14eacc3d0e1eaf0cb4a3c
input  toolchain/sysroot/lib/libc.a sha256 6ec332f954b24058ea980191072f75714c3cd9f530130d2fd1893a02a23d2ce9
output ctest-fortify.elf sha256 b09f1bd314cfbdb5d643273f6e12e7b06a92edf864dbb0b6b256c021b19b025e size 1414432
