# The hwsim driver process: Linux's mac80211_hwsim -- simulated radios on a
# shared medium, which mac80211 drives as it drives a card -- on Linux's
# 802.11 stack (stacks/wifi.manifest), added to what every driver process is
# built from (linuxdrv/emul/manifest; scripts/linux-tree.sh driver). It is
# how the boot test, which has no WiFi card, tests the stack and the layer's
# use of it: one radio made an access point, the other scanning for it
# (linuxdrv/emul/lx_wifi.c's "hwsim" run). `linux` lines: Linux's own
# objects, by path in the tree, built by Linux's make. `include` lines: a
# stack several driver processes share, under linuxdrv/.

# The simulated radios, as Linux builds them.
linux drivers/net/wireless/virtual/mac80211_hwsim.o

include stacks/wifi.manifest
