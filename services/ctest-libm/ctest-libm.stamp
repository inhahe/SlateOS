input  main.c sha256 8b54daea88dc3d2f233032cf1944809ad23bcadb53c4de325cd807c68c533962
input  toolchain/sysroot/lib/libc.a sha256 73efe5b393c3dea1df28f392364cb68c88d14185a14d1734997a460bd8c9a5e1
output ctest-libm.elf sha256 020842469ffba1c1e082fa3dde33451686c34dc5ac68b077b0fc23cabf7fa5a9 size 2650288
