# ctest fixture input stamp - generated by scripts/ctest-fixtures.py
# Records the inputs that produced this ELF, so a source change committed
# without its rebuilt binary is detectable by content. Timestamps cannot
# do this: a fresh checkout gives every file the same mtime.
# Text inputs are hashed with CRLF folded to LF (version 2); binary ones
# byte-for-byte. See `sha256_text` for why.
# Regenerate with: scripts/ctest-fixtures.py build
#   (run it with `python` on Windows, `python3` under WSL/Linux)
version 2
input  build.py sha256 77d760d6ca55933f981b5694b757f702a7873d3b02cb6af3f05962ef7fcf17a9
input  main.c sha256 63d04652d3b60e56441a68b04b13efa36a561491b1c3fe3db08a1634ca71d37f
input  toolchain/sysroot/lib/libc.a sha256 5915b6ca18a2ef670f539b2d142721271287977067ccded75c43679f4af4b2a7
output ctest-ctty.elf sha256 4f1e245ea65461a629437c5ead36b54b04d51c24444ed37b14627f0e61c34a0d size 2639920
