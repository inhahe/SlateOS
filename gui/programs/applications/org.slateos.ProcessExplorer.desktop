# SlateOS's own Process Explorer, as a desktop entry (gui/programs, design-decisions.md 1425).
# Built into the programs library; the same file installs as
# /usr/share/applications/org.slateos.ProcessExplorer.desktop. What each field carries,
# and where it came from, is gui/programs/INVENTORY.md.

[Desktop Entry]
Type=Application
Name=Process Explorer
GenericName=Task Manager
Comment=View and manage running processes
Exec=/usr/bin/procexplorer
TryExec=/usr/bin/procexplorer
Icon=utilities-system-monitor
Categories=System;Monitor;
Keywords=task;manager;top;htop;processes;kill;
