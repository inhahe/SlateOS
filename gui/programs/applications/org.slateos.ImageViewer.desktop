# SlateOS's own Image Viewer, as a desktop entry (gui/programs, design-decisions.md 1425).
# Built into the programs library; the same file installs as
# /usr/share/applications/org.slateos.ImageViewer.desktop. What each field carries,
# and where it came from, is gui/programs/INVENTORY.md.

[Desktop Entry]
Type=Application
Name=Image Viewer
GenericName=Image Viewer
Comment=View images and photos
Exec=/usr/bin/imageviewer %f
TryExec=/usr/bin/imageviewer
Icon=image-x-generic
Categories=Graphics;Viewer;
Keywords=photo;picture;gallery;png;jpg;
MimeType=image/png;image/jpeg;image/gif;image/bmp;image/webp;image/tiff;image/svg+xml;image/x-icon;
