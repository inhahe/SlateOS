# The Linux configuration every driver process is compiled against, applied on
# top of `allnoconfig` (design-decisions 1578). scripts/linux-tree.sh checks
# that every line here is what the resulting .config says: Kconfig drops an
# option whose dependencies are unmet without a word.

CONFIG_64BIT=y

# The execution model (1578 rule 5): one CPU, no preemption.
# CONFIG_SMP is not set
CONFIG_PREEMPT_NONE=y

# Timers: the wheel says when its next timer is due (get_next_timer_interrupt),
# which the layer's loop sleeps no longer than; Linux offers it with NO_HZ.
CONFIG_NO_HZ_IDLE=y

# Nothing that needs the kernel's own runtime: no stack protector (its canary
# is per-CPU data reached through %gs), no mitigation thunks
# (`__x86_return_thunk` and the retpolines are kernel symbols), no modules
# (drivers are built in, and the layer runs their initcalls).
# CONFIG_STACKPROTECTOR is not set
# CONFIG_CPU_MITIGATIONS is not set
# CONFIG_MODULES is not set

# What the drivers below stand on.
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
# WiFi: Linux's own cfg80211 (the configuration API, its regulatory rules
# and scan results) and mac80211 (the 802.11 MAC a "softmac" card's driver
# leaves to the host). Without a regulatory.db among the firmware, cfg80211
# keeps to the world domain, which scans.
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_MEDIATEK=y

# The drivers.
CONFIG_E1000E=y
# The test PC's MediaTek RZ717 (PCI 14C3:0717).
CONFIG_MT7925E=y
# Simulated radios on a shared medium, which mac80211 drives as it drives a
# card: the 802.11 stack tested end to end where there is no card (QEMU).
CONFIG_MAC80211_HWSIM=y
