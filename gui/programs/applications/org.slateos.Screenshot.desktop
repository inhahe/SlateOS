# SlateOS's own Screenshot, as a desktop entry (gui/programs, design-decisions.md 1425).
# Built into the programs library; the same file installs as
# /usr/share/applications/org.slateos.Screenshot.desktop. What each field carries,
# and where it came from, is gui/programs/INVENTORY.md.

[Desktop Entry]
Type=Application
Name=Screenshot
GenericName=Screen Capture
Comment=Capture screen area or window
Exec=/usr/bin/screenshot
TryExec=/usr/bin/screenshot
Icon=applets-screenshooter
Categories=Utility;
Keywords=capture;snip;screen;grab;
