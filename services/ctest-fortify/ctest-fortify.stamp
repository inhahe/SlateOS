input  main.c sha256 fcdc165fc7abb0c5fe224320668ef43b15485c3aa8e14eacc3d0e1eaf0cb4a3c
input  toolchain/sysroot/lib/libc.a sha256 7bbdef32d540ee3f2dd030d5db847a073198ac21a79a960a5d42897faebc5cee
output ctest-fortify.elf sha256 60874ceebdfc984f6a949eaa083c79e7e3ef8f75c50edf5eec16860a58dcd599 size 1414768
