# SlateOS's own Video Player, as a desktop entry (gui/programs, design-decisions.md 1425).
# Built into the programs library; the same file installs as
# /usr/share/applications/org.slateos.VideoPlayer.desktop. What each field carries,
# and where it came from, is gui/programs/INVENTORY.md.

[Desktop Entry]
Type=Application
Name=Video Player
GenericName=Video Player
Comment=Play videos
Exec=/usr/bin/videoplayer %F
TryExec=/usr/bin/videoplayer
Icon=video-x-generic
Categories=AudioVideo;Video;Player;
Keywords=video;vlc;mpv;media;movie;
MimeType=video/mp4;video/x-matroska;video/webm;video/x-msvideo;video/quicktime;video/x-ms-wmv;video/x-flv;
