input  main.c sha256 fcdc165fc7abb0c5fe224320668ef43b15485c3aa8e14eacc3d0e1eaf0cb4a3c
input  toolchain/sysroot/lib/libc.a sha256 a2dbcc11a19b4cd7b9301fdf988d4f86db642726ccf5c38b5a669006686f5e4a
output ctest-fortify.elf sha256 db7786f6d23efbbdab412aacc66edca95a5d8c5d9f39bb3e46f457190ce7e715 size 2634368
