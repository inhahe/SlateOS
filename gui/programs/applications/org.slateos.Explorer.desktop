# SlateOS's own File Explorer, as a desktop entry (gui/programs, design-decisions.md 1425).
# Built into the programs library; the same file installs as
# /usr/share/applications/org.slateos.Explorer.desktop. What each field carries,
# and where it came from, is gui/programs/INVENTORY.md.

[Desktop Entry]
Type=Application
Name=File Explorer
GenericName=File Manager
Comment=Browse and manage files
Exec=/usr/bin/explorer %f
TryExec=/usr/bin/explorer
Icon=system-file-manager
Categories=Utility;System;FileManager;
Keywords=explorer;finder;nautilus;files;browse;folder;directory;
MimeType=inode/directory;
